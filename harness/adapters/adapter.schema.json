{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "harness adapter",
  "description": "스택 의존을 담는 선언형 파일. 코드가 아니라 데이터다. 어댑터는 선언만 하고 분기 로직을 담지 않는다 — 어댑터에 조건문이 필요해지면 그건 코어에 빠진 개념이라는 신호이므로, 필드를 늘리지 말고 코어에 스테이지·신호를 추가한다.",
  "type": "object",
  "required": [
    "id",
    "runner",
    "stages",
    "test_report"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "requires": {
      "description": "이 어댑터를 쓸 수 있는 리포인가. doctor 가 /feature 진입 전에 검사한다.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/requirement"
      }
    },
    "runner": {
      "type": "object",
      "required": [
        "bin"
      ],
      "additionalProperties": false,
      "properties": {
        "bin": {
          "description": "실행 바이너리 화이트리스트. 페이즈 파일·어댑터가 임의 명령 실행 벡터가 되지 않게 하는 장치이며, 목록 확장은 이 enum 한 줄이다. 실행기 코드에는 두지 않는다.",
          "type": "string",
          "enum": [
            "npm",
            "pnpm",
            "yarn",
            "gradlew",
            "gradlew.bat",
            "mvn",
            "python",
            "python3",
            "go",
            "cargo",
            "make"
          ]
        },
        "common_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "script_manifest": {
          "description": "러너가 `<verb> <script>` 로 매니페스트에 선언된 스크립트를 부르는 스택에서, doctor 가 스테이지 명령이 실물 스크립트를 가리키는지 대조할 곳. 어느 파일의 어느 키에 스크립트가 선언돼 있고 러너가 그것을 어떤 동사로 부르는가는 스택의 사실이지 실행기의 사실이 아니다. 선언하지 않으면 그 대조를 '검사 안 함'으로 보고한다 — 통과가 아니다.",
          "type": "object",
          "required": [
            "file",
            "pointer",
            "verb"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "description": "리포 루트 기준 JSON 파일 경로 (예: package.json).",
              "type": "string"
            },
            "pointer": {
              "description": "그 파일 안에서 스크립트 맵까지 가는 점 구분 키 경로 (예: scripts). requires 의 json_key 와 같은 문법이다.",
              "type": "string"
            },
            "verb": {
              "description": "스테이지 cmd 의 첫 인자가 이것과 같을 때만 뒤의 이름을 스크립트로 본다 (예: run). 다른 동사로 시작하는 명령은 대조 대상이 아니다.",
              "type": "string"
            }
          }
        }
      }
    },
    "stages": {
      "description": "스테이지 이름은 코어가 고정하고 명령은 어댑터가 소유한다. 페이즈 파일은 이름만 참조하므로 스택 비종속이 된다.",
      "type": "object",
      "required": [
        "compile",
        "lint",
        "check",
        "scoped",
        "full",
        "e2e",
        "build",
        "docs"
      ],
      "additionalProperties": false,
      "properties": {
        "compile": {
          "$ref": "#/definitions/stage"
        },
        "lint": {
          "$ref": "#/definitions/stage"
        },
        "check": {
          "$ref": "#/definitions/stage"
        },
        "scoped": {
          "$ref": "#/definitions/stage"
        },
        "full": {
          "$ref": "#/definitions/stage"
        },
        "e2e": {
          "$ref": "#/definitions/stage"
        },
        "build": {
          "$ref": "#/definitions/stage"
        },
        "docs": {
          "$ref": "#/definitions/stage"
        }
      }
    },
    "test_report": {
      "type": "object",
      "required": [
        "format",
        "glob"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "junit-xml",
            "jest-json",
            "go-json",
            "none"
          ]
        },
        "glob": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "attribution": {
      "description": "테스트 파일 어휘 — 이름은 역사적이다(귀속 기계는 지웠다, ADR-H075). test_file_globs 는 스코프 선택·예산·계약 대조가, e2e_file_globs·import_aliases 는 계약 대조의 테스트 존재 검사가 읽는다.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test_file_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "import_aliases": {
          "description": "contract-trace untested_entrypoint: 테스트의 import 지정자 접두 → 리포 상대 경로 접두.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "e2e_file_globs": {
          "description": "e2e 스펙과 보조 파일. contract-trace 의 유닛·오류 어휘·진입점 테스트 검사가 이 파일들을 세지 않는다 — e2e 가 유닛 테스트 부재를 가리지 않게 (ADR-H058 추기).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entrypoint_resolver": {
      "description": "계약의 진입점이 실재하는가를 스택 비종속으로 확인한다. none 이면 그 검사만 스킵하고 보고서에 '진입점 미검증'으로 드러난다.",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file-convention",
            "annotation-grep",
            "none"
          ]
        },
        "map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "route",
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "route": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            }
          }
        },
        "pattern": {
          "type": "string"
        },
        "param_styles": {
          "description": "계약의 {name} 파라미터를 실제 경로에서 찾을 때 시도할 괄호 쌍. 두 글자 문자열(예: \"[]\"). 코어는 읽기만 한다 (ADR-H049).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^..$"
          }
        },
        "_param_styles_note": {
          "type": "string"
        }
      }
    },
    "infra_preflight": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "tcp",
              "env"
            ]
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "var": {
            "type": "string"
          },
          "required_when_touched": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "on_missing": {
            "type": "string",
            "enum": [
              "fail",
              "warn"
            ],
            "description": "프로브가 실패했을 때. **미지정이면 `fail`** 이다 — exit 10 이고 런이 멈춘다. `warn` 은 exit 0 + `infra_skipped:<name>` gap 이고 등급이 PASS_WITH_GAPS 로 내려간다 — **면제는 통과가 아니다.** `warn` 은 왜 없어도 회귀가 도는지를 `why` 에 적어야 하고, lint 가 그것을 요구한다."
          },
          "why": {
            "type": "string",
            "description": "`on_missing: warn` 의 근거. 이유 없는 면제는 다음 사람이 검증할 수 없다 — lint 가 요구한다."
          }
        }
      }
    },
    "infra_failure_patterns": {
      "description": "이 패턴에 걸린 실패는 owner: infra 로 분류되어 반복 카운터를 소모하지 않는다. 시스템 문제를 제출물 문제로 설명하지 않기 위한 장치.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "requirement": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "dir",
            "json_key"
          ]
        },
        "path": {
          "type": "string"
        },
        "pointer": {
          "description": "kind=json_key 일 때 점으로 구분한 키 경로 (예: scripts.test).",
          "type": "string"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "cmd"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "description": "null 이면 그 스테이지는 없는 것이고 게이트는 '스킵됨'으로 기록한다. 조용히 통과가 아니다.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "description": "모노레포용 스테이지별 오버라이드.",
          "type": "string"
        },
        "not_applicable": {
          "description": "`cmd: null` 인 스테이지가 이 스택에 **구조적으로 없다**는 선언과 그 사유. 있으면 게이트가 `stage_na:<id>` 로 기록하고 등급을 내리지 않는다. 없으면 `stage_absent:<id>` — 미룬 부재이고 등급이 내려간다 (ADR-H047 추기).",
          "type": "string"
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "when_touched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "select": {
          "description": "스코프 테스트 선택 문법.",
          "type": "object",
          "required": [
            "flag",
            "join"
          ],
          "additionalProperties": false,
          "properties": {
            "flag": {
              "type": "string"
            },
            "join": {
              "type": "string",
              "enum": [
                "space",
                "repeat",
                "comma"
              ]
            }
          }
        }
      }
    }
  }
}
