{
  "schema": 1,

  "project": {
    "name": "{{name}}",
    "language": "ko",
    "instruction_file": "CLAUDE.md",
    "instruction_slot_budget": 12,
    "rules_dir": "docs",
    "instruction_review": {"skill": "claude-md-management:revise-claude-md"},
    "secret_files": [".env.local", ".env"]
  },

  "adapter": "nextjs-ts",

  "contract": {
    "path_template": "_workspace/contract_{slug}.md",
    "sections": {
      "units": "## 유닛",
      "entrypoints": "## 진입점",
      "errors": "## 오류 어휘",
      "data_shapes": "## 데이터 형태",
      "schema": "## 스키마·데이터 변경",
      "boundaries": "## 외부 경계",
      "journeys": "## 여정",
      "screens": "## 화면"
    },
    "required": ["units"]
  },

  "vcs": {
    "forge": "github",
    "remote": "origin",
    "base_branch": "main",
    "branch_pattern": "^feat-[a-z0-9-]+$",
    "protected": ["main"]
  },

  "roles": [
    {
      "id": "impl",
      "agent": "impl-writer",
      "code": "impl",
      "owns": ["src/app/**", "src/lib/**", "src/services/**", "src/types/**"],
      "excludes": ["**/*.test.ts", "**/*.test.tsx", "**/*.golden.test.ts", "src/app/**/*.tsx"]
    },
    {
      "id": "test",
      "agent": "test-writer",
      "code": "test",
      "owns": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.golden.test.ts", "e2e/**"]
    },
    {
      "id": "ui",
      "agent": "ui-writer",
      "code": "ui",
      "owns": ["src/components/**", "src/app/**/*.tsx"],
      "excludes": ["src/app/api/**", "**/*.test.tsx"],
      "when_contract_section": "screens"
    }
  ],
  "primary_role": "impl",

  "main_owned_paths": [
    "harness/**",
    "docs/**",
    "scripts/**",
    ".claude/**",
    "phases/**",
    ".github/**",
    "*.md",
    "*.json",
    "*.mjs",
    "*.ts",
    ".gitignore",
    ".env*"
  ],

  "cross_verify": {
    "required": false,
    "primary": null,
    "fallback": "plan-reviewer"
  },

  "_budget_note": "lines_max 는 400 에서 1000 으로 올렸다 — 실측이 아니라 실제 작업에서 exit 9(예산 초과, 사람 확인 대기)가 반복적으로 발동하는 마찰 때문이다. 1000 도 여전히 미검증 초기값이다. files_max(10)·model_calls_max(24)는 이번에 안 건드렸다.",
  "budget": {"files_max": 10, "lines_max": 1000, "model_calls_max": 24},
  "profile": {"small_max_units": 3, "inv_skip_below_chars": 400},

  "_triage_note": "전부 **미검증**이다 — 기계 신호 임계값은 실측 없이 고른 초기값이다. 00 이 요청 원문의 구조 신호(언급된 경로·길이·개수)만 읽고 언어 키워드는 읽지 않는다. 첫 세 런의 00_triage.json 과 triage_miss 이벤트가 이 값을 검사한다: miss 가 docs 예측에서만 나면 docs 규칙이 헐거운 것이고, 모델 호출이 매 런 나면 규칙이 너무 좁은 것이다.",
  "triage": {
    "small_max_paths": 3,
    "normal_min_chars": 1500,
    "model_call_when_undecided": true
  },

  "_models_note": "전부 **미검증**이다 — 슬롯별 모델 등급은 실측 없이 고른 값이다 (ADR-H061 로 1차 개정). 원칙은 작성자는 싸게(roles 는 전 레인 sonnet — 계약이 자유도를 묶었고 04 게이트·05 리뷰가 뒤에 있다), 검사자는 비싸게(plan · xv · reviewers 는 normal 에서 opus — 내용 품질에 기계 검사가 없다). 표에 inherit 는 없다 — 있으면 state.models.instructed 에 실값이 안 남고 워커 비용이 메인 세션 모델에 묶인다. 봉투가 지시 키마다 `model: X` 를 찍고 /feature 가 그 값을 Agent 호출의 model 인자로 그대로 넘긴다. 실행기는 실제로 어느 모델이 돌았는지 볼 수 없다. effort 는 여기가 아니라 .claude/agents/*.md 프론트매터가 역할별로 정한다 — Agent 호출 인자에 effort 가 없어 레인별로는 못 바꾼다. 05 수리 작성자는 지시 키가 없어 이 표 밖(메인 세션 모델)이다. xv 는 primary 가 MCP 도구라 폴백 에이전트(plan-reviewer)에만 적용된다. 프로파일 키가 없으면 default 로 낙하한다.",
  "models": {
    "triage":    {"default": "haiku"},
    "plan":      {"default": "sonnet", "fix": "sonnet", "normal": "opus"},
    "xv":        {"default": "opus"},
    "roles":     {"default": "sonnet", "fix": "sonnet"},
    "reviewers": {"default": "sonnet", "fix": "sonnet", "normal": "opus"}
  },
  "background_threshold_sec": 180,
  "calibration_file": "harness/calibration.json"
}
