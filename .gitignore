# 스택 산출물은 프로젝트가 자기 것을 적는다 (예: node_modules/ · target/ · __pycache__/).
# 아래 항목은 스택과 무관하게 하네스 자신이 요구하는 것들이다.

# phase execution outputs
phases/**/phase*-output.json
phases/**/step*-output.json

# 실행 중 상태 (M10). 산출물이 아니라 살아 있는 프로세스의 표식이고,
# _finalize 의 `git add -A` 가 이것을 커밋에 쓸어담은 적이 있다.
phases/*/RUNNING
phases/*/RUNNING.tmp

# 로컬 시크릿 — 절대 커밋하지 않는다 (TRD 6.5 시크릿 관리)
.env.local
.env*.local

# 하네스 테스트 리포트 (harness/adapters/nextjs-ts.json 의 test_report.glob).
# 루트에 앵커한다 — 앵커 없는 reports/ 는 어느 깊이에서든 매칭한다.
/reports/

# 파이프라인 런 작업 공간 — 원시 텔레메트리와 계약 파일.
# 보고서만 docs/harness/pipeline/runs/ 로 tracked 된다 (08 페이즈 파일).
_workspace/

# python 바이트코드
__pycache__/
.pytest_cache/
